# App
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

# Auth0 (https://auth0.com)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Generate: openssl rand -hex 32

# Closed beta allowlist (comma-separated emails, case-insensitive).
BETA_ALLOWLIST_EMAILS=
BETA_SOFT_CAP=100

# Local UI without Auth0 (never enable in production)
AUTH_DEV_BYPASS=false
AUTH_DEV_EMAIL=dev@fintrack.local
AUTH_DEV_NAME=Dev Tester

# MongoDB Atlas
DATABASE_URL=mongodb+srv://USER:PASS@CLUSTER/fintrack?retryWrites=true&w=majority

# Seed demo budget on first login
SEED_DEMO_ON_LOGIN=true
SEED_TEMPLATE_VERSION=1

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_KEY=

# Feedback (operator mailbox)
FEEDBACK_EMAIL=feedback@example.com
